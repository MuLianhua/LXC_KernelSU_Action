# 内核源码地址
KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_lge_sm8150

# 内核源码分支
KERNEL_SOURCE_BRANCH=lineage-22.2

# 内核编译配置
KERNEL_CONFIG=vendor/lineageos_flash_defconfig

# 内核打包名字，自定义，支持英文数字
KERNEL_ZIP_NAME=LG_V50_LineageOS_Docker_Kernel

# 是否开启kvm (不需要)
ENABLE_KVM=false

# 是否开启lxc-docker (核心需求，必须开启)
ENABLE_LXC_DOCKER=true

# 选择要打包的内核镜像文件 (低端机填这个)
KERNEL_IMAGE_NAME=Image.gz-dtb

# 是否需要LLVM=1 LLVM_IAS=1参数 (4.14老内核强烈建议填 n)
LLVM_CONFIG=n

# 是否需要切换python2 (不需要)
SWITCH_PYTHON=false

# 是否需要dtbo (不需要)
NEED_DTBO=false

# ksu部分 (先不集成，设为false)
ENABLE_KERNELSU=false
KERNELSU_TAG=v0.9.5.1
